<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Step 1: 목표 선택 -->
    <LinearLayout
        android:id="@+id/step_select_goal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="위젯에 표시할 목표를 선택하세요"
            android:textSize="15sp"
            android:textColor="@color/text_secondary"
            android:background="@color/surface" />

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@color/divider" />

        <TextView
            android:id="@+id/tv_config_empty"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_gravity="center_horizontal"
            android:gravity="center"
            android:text="등록된 목표가 없습니다.\n아래 버튼으로 새 목표를 만드세요."
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_config_goals"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="16dp"
            android:clipToPadding="false" />

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@color/divider" />

        <LinearLayout
            android:id="@+id/btn_create_new"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/surface"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+ 새 목표 만들기"
                android:textSize="15sp"
                android:textColor="@color/primary"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

    <!-- Step 2: 투명도 설정 -->
    <LinearLayout
        android:id="@+id/step_opacity"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="위젯 투명도 설정"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tv_selected_goal_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="32dp" />

        <!-- 위젯 미리보기 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="미리보기"
            android:textSize="12sp"
            android:textColor="@color/text_hint"
            android:textAllCaps="true"
            android:layout_marginBottom="12dp" />

        <!-- 미리보기 컨테이너 (체커보드 배경으로 투명도 시각화) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginBottom="32dp"
            android:background="@drawable/checkerboard_bg">

            <LinearLayout
                android:id="@+id/preview_widget"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="12dp"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:id="@+id/preview_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="목표 이름"
                        android:textColor="#F1F5F9"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:ellipsize="end"
                        android:maxLines="1" />

                    <TextView
                        android:id="@+id/preview_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:text="50 / 100"
                        android:textColor="#94A3B8"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/preview_rate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="50%"
                        android:textColor="#F1F5F9"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <ProgressBar
                    android:id="@+id/preview_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:max="100"
                    android:progress="50"
                    android:progressDrawable="@drawable/widget_progress_drawable" />

            </LinearLayout>

        </FrameLayout>

        <!-- 투명도 레이블 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="투명도"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tv_opacity_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="90%"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:minWidth="52dp"
                android:gravity="end" />

        </LinearLayout>

        <!-- 슬라이더 -->
        <SeekBar
            android:id="@+id/seekbar_opacity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="90"
            android:layout_marginBottom="8dp" />

        <!-- 양 끝 라벨 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="32dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="투명"
                android:textSize="11sp"
                android:textColor="@color/text_hint" />
            <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="불투명"
                android:textSize="11sp"
                android:textColor="@color/text_hint" />
        </LinearLayout>

        <!-- 확인 버튼 -->
        <TextView
            android:id="@+id/btn_opacity_confirm"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center"
            android:text="위젯 추가"
            android:textSize="16sp"
            android:textColor="@color/surface"
            android:textStyle="bold"
            android:background="@drawable/btn_primary"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</LinearLayout>
